# MELANO Command Center
# Copy these variables into Vercel Project Settings > Environment Variables.
# Never commit service-role keys, OAuth client secrets, AI gateway keys, webhook tokens, or other secrets.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_IN_VERCEL_ONLY

# AI: Vercel AI Gateway. AI_GATEWAY_API_KEY is optional on Vercel when VERCEL_OIDC_TOKEN is available.
AI_GATEWAY_API_KEY=SET_IN_VERCEL_ONLY_IF_NOT_USING_OIDC

# Canonical Command Center dispatcher
N8N_COMMAND_CENTER_WEBHOOK=https://melanoinc.app.n8n.cloud/webhook/command-center
N8N_COMMAND_CENTER_TOKEN=SET_IN_VERCEL_ONLY
